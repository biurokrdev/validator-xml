{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "d2-gui-viewereditor": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "d2",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "logo.svg",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "/"
              },
              {
                "glob": "**/*.bcmap",
                "input": "node_modules/pdfjs-dist/cmaps",
                "output": "/pdfjs/cmaps"
              },
              {
                "glob": "**/*.{pfb,ttf}",
                "input": "node_modules/pdfjs-dist/standard_fonts",
                "output": "/pdfjs/standard_fonts"
              },
              {
                "glob": "**/*.{wasm,js}",
                "input": "node_modules/pdfjs-dist/wasm",
                "output": "/pdfjs/wasm"
              },
              {
                "glob": "**/*.icc",
                "input": "node_modules/pdfjs-dist/iccs",
                "output": "/pdfjs/iccs"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/pdfjs-dist/web/pdf_viewer.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "48kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "d2-gui-viewereditor:build:production"
            },
            "development": {
              "buildTarget": "d2-gui-viewereditor:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "::development",
            "runner": "vitest",
            "setupFiles": ["src/test-setup.ts"],
            "providersFile": "src/test-providers.ts"
          }
        }
      }
    }
  }
}
