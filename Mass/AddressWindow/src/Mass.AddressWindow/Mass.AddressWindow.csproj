<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mass.AddressWindow</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Walidacja pisma PDF do koperty z okienkiem: adres odbiorcy w oknie adresata, nalepka R w oknie nadawcy, podgląd strony. PdfPig (Apache 2.0) do pozycji tekstu, PDFtoImage/PDFium (MIT/BSD) do renderowania.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\LiberationSans-Regular.ttf" LogicalName="Mass.AddressWindow.Pdf.Fonts.LiberationSans-Regular.ttf" />
    <None Include="Fonts\LICENSE-LiberationSans.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mass.AddressWindow.Tests" />
  </ItemGroup>

</Project>
