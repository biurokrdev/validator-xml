<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mass.RLabel</RootNamespace>
    <AssemblyName>Mass.RLabel</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Generowanie grafiki nalepki „R” listu poleconego (kod kreskowy GS1-128 / Code 128) jako PNG lub JPEG. Działa na Windows i Linux bez fontów systemowych.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp: licencja MIT. Wariant NoDependencies dla Linuksa nie wymaga libfontconfig ani innych bibliotek
         systemowych, więc działa w minimalnych obrazach kontenerów (np. mcr.microsoft.com/dotnet/aspnet). -->
    <PackageReference Include="SkiaSharp" Version="4.153.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonty Liberation Sans (SIL Open Font License 1.1) osadzone w bibliotece: tekst renderuje się identycznie
         na każdym systemie, także bez zainstalowanych fontów. Licencja: Fonts/LICENSE-LiberationSans.txt. -->
    <EmbeddedResource Include="Fonts\LiberationSans-Regular.ttf" LogicalName="Mass.RLabel.Fonts.LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Fonts\LiberationSans-Bold.ttf" LogicalName="Mass.RLabel.Fonts.LiberationSans-Bold.ttf" />
    <None Include="Fonts\LICENSE-LiberationSans.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mass.RLabel.Tests" />
  </ItemGroup>

</Project>
