          "filter": {
            "bool": {
              "filter": [
                {
                  "term": {
                    "httpMethod": "PUT"
                  }
                },
                {
                  "term": {
                    "route": "/api/documentstorage/{id}/versions/{id}"
                  }
                },
                {
                  "range": {
                    "statusCode": {
