
GET DOC2_APP_LOGS_INDEX/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-24h"
            }
          }
        },
        {
          "term": {
            "container.name": "doc2tools-viewer-service"
          }
        },
        {
          "match_phrase": {
            "message": "Zewnętrzny ingest dokumentu OK"
          }
        },
        {
          "exists": {
            "field": "MasterId"
          }
        }
      ]
    }
  },
  "aggs": {
    "pliki_unikalne": {
      "cardinality": {
        "field": "MasterId"
      }
    },
    "wg_mime": {
      "terms": {
        "field": "Mime",
        "size": 10
      }
    },
    "wg_klasyfikacji": {
      "terms": {
        "field": "Classification",
        "size": 10,
        "missing": "brak"
      }
    },
    "w_czasie": {
      "date_histogram": {
        "field": "@timestamp",
        "calendar_interval": "1h"
      }
    }
  }
}

