                  }
                },
                {
                  "term": {
                    "route": "/api/documentstorage/{id}/versions/{id}/finish"
                  }
                },
                {
                  "range": {
                    "statusCode": {
                      "lt": 300
                    }
                  }
                }
              ]
            }
          }
        },
        "ostatnia_aktywnosc": {
          "max": {
            "field": "@timestamp"
          }
        },
        "tylko_w_toku": {
          "bucket_selector": {
            "buckets_path": {
              "o": "otwarte._count",
              "z": "zakonczone._count"
            },
            "script": "params.o > 0 && params.z == 0"
          }
        }
      }
    }
  }
}

