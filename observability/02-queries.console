              "/api/documentstorage/{id}/user-download",
              "/api/documentstorage/{id}/download",
              "/api/documentstorage/{id}/versions/{id}/download"
            ]
          }
        }
      ]
    }
  },
  "runtime_mappings": {
    "route": {
      "type": "keyword",
      "script": {
        "source": "String p=null; if(doc.containsKey('httpPath.keyword')&&doc['httpPath.keyword'].size()>0){p=doc['httpPath.keyword'].value;} else if(doc.containsKey('httpPath')&&doc['httpPath'].size()>0){p=doc['httpPath'].value;} else if(doc.containsKey('RequestPath.keyword')&&doc['RequestPath.keyword'].size()>0){p=doc['RequestPath.keyword'].value;} else if(doc.containsKey('RequestPath')&&doc['RequestPath'].size()>0){p=doc['RequestPath'].value;} else if(doc.containsKey('url.path')&&doc['url.path'].size()>0){p=doc['url.path'].value;} if(p==null){return;} StringBuilder sb=new StringBuilder(); for(String s: p.splitOnToken('/')){ if(s.length()==0){continue;} sb.append('/'); if(s.length()==36&&s.substring(8,9)=='-'&&s.substring(13,14)=='-'&&s.substring(18,19)=='-'&&s.substring(23,24)=='-'){sb.append('{id}');} else {sb.append(s.toLowerCase());} } emit(sb.length()==0?'/':sb.toString());"
      }
    },
    "doc_id": {
      "type": "keyword",
      "script": {
        "source": "String p=null; if(doc.containsKey('httpPath.keyword')&&doc['httpPath.keyword'].size()>0){p=doc['httpPath.keyword'].value;} else if(doc.containsKey('httpPath')&&doc['httpPath'].size()>0){p=doc['httpPath'].value;} else if(doc.containsKey('RequestPath.keyword')&&doc['RequestPath.keyword'].size()>0){p=doc['RequestPath.keyword'].value;} else if(doc.containsKey('RequestPath')&&doc['RequestPath'].size()>0){p=doc['RequestPath'].value;} else if(doc.containsKey('url.path')&&doc['url.path'].size()>0){p=doc['url.path'].value;} if(p==null){return;} for(String s: p.splitOnToken('/')){ if(s.length()==36&&s.substring(8,9)=='-'&&s.substring(13,14)=='-'&&s.substring(18,19)=='-'&&s.substring(23,24)=='-'){emit(s.toLowerCase()); return;} }"
      }
    },
    "app": {
      "type": "keyword",
      "script": {
        "source": "if(doc.containsKey('container.name')&&doc['container.name'].size()>0){emit(doc['container.name'].value);return;} if(doc.containsKey('service.keyword')&&doc['service.keyword'].size()>0){emit(doc['service.keyword'].value);return;} if(doc.containsKey('service')&&doc['service'].size()>0){emit(doc['service'].value);return;} emit('unknown');"
      }
    }
  },
  "aggs": {
    "wg_trasy": {
      "terms": {
        "field": "route",
        "size": 10
      },
      "aggs": {
        "wg_statusu": {
          "terms": {
            "field": "statusCode",
            "size": 5
          }
        }
      }
    },
    "uzytkownicy_dotknieci": {
      "cardinality": {
        "field": "userId"
      }
    }
  }
}

GET filebeat-*/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-24h"
            }
          }
        },
        {
          "term": {
            "event.dataset": "nginx.access"
          }
        },
        {
          "range": {
            "http.response.status_code": {
              "gte": 400
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "wg_statusu": {
      "terms": {
        "field": "http.response.status_code",
        "size": 10
      }
    },
    "wg_sciezki": {
      "terms": {
        "field": "url.original",
        "size": 15
      }
    }
  }
}

POST _query
{
  "query": """
FROM DOC2_APP_LOGS_INDEX
| WHERE @timestamp >= NOW() - 24 hours
| EVAL path = COALESCE(httpPath, RequestPath, url.path)
| EVAL r = TO_LOWER(REPLACE(path, "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}", "{id}"))
| EVAL is_access = elapsedMs IS NOT NULL OR Elapsed IS NOT NULL
| STATS
    przyjete_pliki      = COUNT(CASE(container.name == "doc2tools-viewer-service" AND STARTS_WITH(message, "Zewnętrzny ingest dokumentu OK"), 1, NULL)),
    odeslane_pliki      = COUNT(CASE(message == "Delivery sent to recipient", 1, NULL)),
    edytowane_15min     = COUNT_DISTINCT(CASE(is_access AND httpMethod == "PUT" AND r == "/api/documentstorage/{id}/versions/{id}" AND statusCode < 300 AND @timestamp >= NOW() - 15 minutes, path, NULL)),
    pobrania_edytowany  = COUNT(CASE(is_access AND httpMethod == "POST" AND r == "/api/documentstorage/{id}/user-download" AND statusCode == 200, 1, NULL)),
    pobrania_oryginal   = COUNT(CASE(is_access AND httpMethod == "GET" AND r == "/api/documentstorage/{id}/download" AND statusCode == 200, 1, NULL)),
    pobrania_oryg_dysk  = COUNT(CASE(is_access AND httpMethod == "GET" AND r == "/api/documentstorage/{id}/download" AND statusCode == 200 AND url.query == "reason=userDownload", 1, NULL)),
    zakonczono          = COUNT(CASE(is_access AND httpMethod == "POST" AND r == "/api/documentstorage/{id}/versions/{id}/finish" AND statusCode < 300, 1, NULL)),
    bledy_webapi        = COUNT(CASE(container.name == "doc2tools-viewer-api" AND level IN ("Error", "Critical"), 1, NULL)),
    bledy_services      = COUNT(CASE(container.name == "doc2tools-viewer-service" AND level IN ("Error", "Critical", "Fatal"), 1, NULL)),
    http5xx_webapi      = COUNT(CASE(container.name == "doc2tools-viewer-api" AND is_access AND statusCode >= 500, 1, NULL)),
    http5xx_services    = COUNT(CASE(container.name == "doc2tools-viewer-service" AND is_access AND statusCode >= 500, 1, NULL))
  """
}

POST _query
{
  "query": """
FROM DOC2_APP_LOGS_INDEX
| WHERE @timestamp >= NOW() - 7 days AND container.name == "doc2tools-viewer-api" AND elapsedMs IS NOT NULL
| GROK httpPath "/api/documentstorage/%{UUID:doc_id}"
| WHERE doc_id IS NOT NULL
| EVAL r = TO_LOWER(REPLACE(httpPath, "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}", "{id}"))
| STATS
    otwarte       = MAX(CASE(httpMethod == "GET"  AND r == "/api/documentstorage/{id}/versions/{id}/download" AND statusCode == 200, 1, 0)),
    zapisy        = COUNT(CASE(httpMethod == "PUT"  AND r == "/api/documentstorage/{id}/versions/{id}" AND statusCode < 300, 1, NULL)),
    ostatni_zapis = MAX(CASE(httpMethod == "PUT"  AND r == "/api/documentstorage/{id}/versions/{id}" AND statusCode < 300, @timestamp, NULL)),
    zakonczone    = MAX(CASE(httpMethod == "POST" AND r == "/api/documentstorage/{id}/versions/{id}/finish"   AND statusCode < 300, 1, 0))
  BY doc_id
| WHERE otwarte == 1 AND zakonczone == 0
| SORT ostatni_zapis DESC
| LIMIT 500
  """
}

POST _query
{
  "query": """
FROM DOC2_APP_LOGS_INDEX
| WHERE @timestamp >= NOW() - 7 days AND container.name == "doc2tools-viewer-api" AND elapsedMs IS NOT NULL
| GROK httpPath "/api/documentstorage/%{UUID:doc_id}"
| WHERE doc_id IS NOT NULL
| EVAL r = TO_LOWER(REPLACE(httpPath, "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}", "{id}"))
| STATS
    otwarte    = MAX(CASE(httpMethod == "GET"  AND r == "/api/documentstorage/{id}/versions/{id}/download" AND statusCode == 200, 1, 0)),
    zakonczone = MAX(CASE(httpMethod == "POST" AND r == "/api/documentstorage/{id}/versions/{id}/finish"   AND statusCode < 300, 1, 0))
  BY doc_id
| WHERE otwarte == 1 AND zakonczone == 0
| STATS dokumentow_w_toku = COUNT(*)
  """
}

POST _query
{
  "query": """
FROM DOC2_APP_LOGS_INDEX
| WHERE @timestamp >= NOW() - 1 day
| STATS ostatni_wpis = MAX(@timestamp), wpisow = COUNT(*) BY container.name, resource.labels.pod_name
| EVAL cisza_min = DATE_DIFF("minutes", ostatni_wpis, NOW())
| SORT cisza_min DESC
  """
}

POST _query
{
  "query": """
FROM DOC2_APP_LOGS_INDEX
| WHERE @timestamp >= NOW() - 24 hours AND level IN ("Error", "Critical", "Fatal")
| EVAL app = CASE(source == "browser", "D2GuiViewerEditor (browser)", container.name)
| EVAL godzina = DATE_TRUNC(1 hour, @timestamp)
| STATS bledy = COUNT(*), typow = COUNT_DISTINCT(exceptionType), requestow = COUNT_DISTINCT(correlationId) BY app, godzina
| SORT godzina DESC, bledy DESC
  """
}

POST _query
{
  "query": """
FROM heartbeat-*
| WHERE @timestamp >= NOW() - 24 hours
| STATS ostatnio = MAX(@timestamp),
        sond = COUNT(*),
        down = COUNT(CASE(monitor.status == "down", 1, NULL)),
        ostatni_down = MAX(CASE(monitor.status == "down", @timestamp, NULL))
  BY monitor.id, monitor.name
| EVAL dostepnosc_pct = ROUND(100.0 * (sond - down) / sond, 2)
| SORT monitor.id
  """
}
