
PUT _ingest/pipeline/d2-logs
{
  "description": "D2 ViewerEditor: normalizacja logów WebApi/Services do wspólnego kształtu",
  "processors": [
    {
      "set": {
        "if": "ctx['@timestamp'] == null && ctx.timestamp != null",
        "field": "@timestamp",
        "copy_from": "timestamp"
      }
    },
    {
      "script": {
        "description": "Services: service (string) -> service.name; environment -> service.environment",
        "lang": "painless",
        "source": "if (ctx.service instanceof String) { String n = ctx.service; ctx.service = ['name': n]; if (ctx.environment != null) { ctx.service.environment = ctx.environment; } }"
      }
    },
    { "convert": { "field": "statusCode", "type": "long",   "ignore_missing": true, "ignore_failure": true } },
    { "convert": { "field": "StatusCode", "type": "long",   "ignore_missing": true, "ignore_failure": true } },
    { "convert": { "field": "elapsedMs",  "type": "long",   "ignore_missing": true, "ignore_failure": true } },
    { "convert": { "field": "Elapsed",    "type": "double", "ignore_missing": true, "ignore_failure": true } },
    {
      "set": {
        "description": "Serilog 'Fatal' == MS 'Critical' — jeden słownik poziomów w obu API",
        "if": "ctx.level == 'Fatal'",
        "field": "level",
        "value": "Critical"
      }
    }
  ]
}



PUT _index_template/logs-d2
{
  "index_patterns": ["logs-d2-*"],
  "priority": 200,
  "template": {
    "settings": {
      "index.default_pipeline": "d2-logs"
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp":     { "type": "date" },
        "timestamp":      { "type": "date" },
        "message":        { "type": "text" },
        "level":          { "type": "keyword" },
        "severity":       { "type": "keyword" },
        "category":       { "type": "keyword" },
        "exceptionType":  { "type": "keyword" },
        "log":            { "properties": { "level": { "type": "keyword" }, "logger": { "type": "keyword" }, "template": { "type": "keyword", "ignore_above": 512 } } },
        "error":          { "properties": { "type": { "type": "keyword" }, "message": { "type": "text" }, "stack_trace": { "type": "text" }, "inner": { "type": "text" } } },
        "event":          { "properties": { "reason": { "type": "keyword" }, "dataset": { "type": "keyword" }, "kind": { "type": "keyword" }, "type": { "type": "keyword" }, "category": { "type": "keyword" } } },
        "service":        { "properties": { "name": { "type": "keyword" }, "version": { "type": "keyword" }, "environment": { "type": "keyword" }, "instance": { "properties": { "id": { "type": "keyword" } } } } },
        "http":           { "properties": { "request": { "properties": { "method": { "type": "keyword" } } }, "response": { "properties": { "status_code": { "type": "long" } } } } },
        "url":            { "properties": { "path": { "type": "keyword" }, "query": { "type": "keyword" } } },
        "user":           { "properties": { "id": { "type": "keyword" } } },

        "httpMethod":     { "type": "keyword" },
        "httpPath":       { "type": "keyword" },
        "statusCode":     { "type": "long" },
        "elapsedMs":      { "type": "long" },
        "userId":         { "type": "keyword" },
        "requestId":      { "type": "keyword" },
        "correlationId":  { "type": "keyword" },
        "correlation_id": { "type": "keyword" },
        "traceId":        { "type": "keyword" },

        "RequestMethod":  { "type": "keyword" },
        "RequestPath":    { "type": "keyword" },
        "StatusCode":     { "type": "long" },
        "Elapsed":        { "type": "double" },

        "masterId":       { "type": "keyword" },
        "versionId":      { "type": "keyword" },
        "deliveryId":     { "type": "keyword" },
        "attempt":        { "type": "long" },
        "MasterId":       { "type": "keyword" },
        "VersionId":      { "type": "keyword" },
        "Mime":           { "type": "keyword" },
        "Classification": { "type": "keyword" },
        "Error":          { "type": "keyword", "ignore_above": 1024 },
        "RequestName":    { "type": "keyword" },

        "source":         { "type": "keyword" },
        "clientRoute":    { "type": "keyword" },
        "appVersion":     { "type": "keyword" },

        "Request":        { "type": "object", "enabled": false }
      }
    }
  }
}

POST _ingest/pipeline/d2-logs/_simulate
{
  "docs": [
    { "_source": { "timestamp": "2026-09-23T10:00:00.000Z", "severity": "INFO", "level": "Information", "message": "HTTP POST /api/v1/document responded 201 in 120.5 ms", "service": "D2ServicesViewerEditor.Api", "environment": "Production", "httpMethod": "POST", "httpPath": "/api/v1/document", "statusCode": 201, "RequestMethod": "POST", "RequestPath": "/api/v1/document", "StatusCode": 201, "Elapsed": 120.5 } },
    { "_source": { "@timestamp": "2026-09-23T10:00:01.000Z", "timestamp": "2026-09-23T10:00:01.000Z", "severity": "INFO", "level": "Information", "message": "HTTP GET /api/documentstorage/9f2c0a1e-1111-2222-3333-444455556666/download responded 200 in 31 ms (user=abc)", "service": { "name": "D2ViewerEditor.Api", "version": "1.2.3", "environment": "Production", "instance": { "id": "d2-api-00001-abc" } }, "httpMethod": "GET", "httpPath": "/api/documentstorage/9f2c0a1e-1111-2222-3333-444455556666/download", "statusCode": 200, "elapsedMs": 31, "userId": "abc", "url": { "path": "/api/documentstorage/9f2c0a1e-1111-2222-3333-444455556666/download", "query": "reason=userDownload" } } }
  ]
}

