{
  // Potok = lista kroków wykonywanych po kolei na tym samym dokumencie. Każdy krok: "worker" (nazwa z rejestru) + jego konfiguracja
  // (płasko, jak w edytorze workerów). Klucze potoku: enabled, when, unless, on-error.
  "name": "Pismo w sprawie",
  "steps": [
    // 1. Klauzula dla firm znika, gdy sprawa dotyczy osoby fizycznej; klauzula RODO zostaje (ramka formantu zdjęta).
    { "worker": "content-control-remover", "tag-name": "klauzula_firmowa", "remove-when": "osoba_fizyczna" },
    { "worker": "content-control-remover", "tag-name": "klauzula_rodo", "remove-when": "osoba_fizyczna", "negate": true, "unwrap": true },

    // 2. Uwagi przy zakładce; brak uwag = tekst zastępczy.
    { "worker": "bookmark-text", "bookmark-name": "uwagi", "model-property-path": "uwagi", "null-text": "brak uwag" },

    // 3. Tabele „wiele rekordów” – worker z wtyczki DocxPipeline.TableTable (odkryty refleksją w katalogu programu).
    //    Przed field-replacer, żeby znaczniki rekordów (<%nazwa_zalacznika%> …) nie zostały wcześniej dotknięte wiązaniem po nazwie.
    { "worker": "record-table", "tag": "tabela_zalaczniki", "model-property-path": "zalaczniki_zglaszajacego", "empty-text": "Brak załączników" },
    { "worker": "record-table", "tag": "tabela_wiadomosci", "model-property-path": "wiadomosci", "empty-text": "Brak wiadomości w sprawie.",
      "collections": [ { "tag-name": "nazwy_zalacznikow", "empty-text": "brak załączników" } ],
      "content-controls": [
        { "tag-name": "ikona_wyslana",  "visible-property-path": "data_czas_wiadomosci", "visible-when-matches": "^Wysłana", "unwrap": true },
        { "tag-name": "ikona_odebrana", "visible-property-path": "data_czas_wiadomosci", "visible-when-matches": "^Odebrana", "unwrap": true } ] },

    // 4. Pola proste w całym dokumencie: po nazwie (<%temat_sprawy%> → model.temat_sprawy) plus jawne mapowanie z formatem daty.
    { "worker": "field-replacer",
      "fields": [ { "search-for": "<%data_pisma%>", "model-property-path": "data_pisma", "display-format": "dd.MM.yyyy" } ] },

    // 5. Krok warunkowy (pominięty, bo powod_zamkniecia jest ustawiony) i krok z nieznanym workerem (błąd nie przerywa potoku).
    { "worker": "bookmark-text", "bookmark-name": "uwagi", "text": "(sprawa otwarta)", "unless": "powod_zamkniecia" },
    { "worker": "podpis-kwalifikowany", "on-error": "continue", "certyfikat": "..." }
  ]
}
